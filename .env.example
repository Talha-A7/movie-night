# Copy to .env.local and fill in. On Vercel, add the same keys under Project → Settings → Environment Variables.

# Supabase (Project Settings → API). Used only for Realtime Broadcast + Presence — no tables needed.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional but strongly recommended: a relay (TURN) server so video works across strict networks.
# Server-side only — never sent to the browser except as short-lived credentials.
# Option A: Metered (free tier) — https://dashboard.metered.ca
METERED_APP=
METERED_API_KEY=
# Option B: any TURN server (comma-separated URLs)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
